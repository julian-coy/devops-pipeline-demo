        </mxCell>

        <!-- main → PROD pipeline -->
        <mxCell id="arrow-main-pipeline" value="PR / manual" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ba7517;strokeWidth=2;fontColor=#ba7517;fontStyle=1;" edge="1" parent="1" source="branch-main" target="actions-prod-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DEV pipeline → DEV EC2 -->
        <mxCell id="arrow-pipeline-dev" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1a9e75;strokeWidth=2;fontColor=#1a9e75;fontStyle=1;" edge="1" parent="1" source="step-f" target="dev-ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PROD pipeline → PROD EC2 -->
        <mxCell id="arrow-pipeline-prod" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#ba7517;strokeWidth=2;fontColor=#ba7517;fontStyle=1;" edge="1" parent="1" source="prod-step-f" target="prod-ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DEV pipeline → S3 DEV (remote state) -->
        <mxCell id="arrow-dev-s3" value="remote state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4CAF50;strokeWidth=1;dashed=1;fontColor=#4CAF50;fontSize=9;" edge="1" parent="1" source="actions-dev-box" target="s3-dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PROD pipeline → S3 PROD (remote state) -->
        <mxCell id="arrow-prod-s3" value="remote state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#FF9800;strokeWidth=1;dashed=1;fontColor=#FF9800;fontSize=9;" edge="1" parent="1" source="actions-prod-box" target="s3-prod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pipelines → DynamoDB (locking) -->
        <mxCell id="arrow-dev-dynamo" value="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#9C27B0;strokeWidth=1;dashed=1;fontColor=#9C27B0;fontSize=9;" edge="1" parent="1" source="actions-dev-box" target="dynamodb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
